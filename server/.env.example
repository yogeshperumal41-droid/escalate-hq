PORT=5001
NODE_ENV=development

# MongoDB: leave blank to auto-use in-memory MongoDB, or specify MongoDB connection string
MONGODB_URI=

# JWT Secret
JWT_SECRET=escalate_hq_super_secure_jwt_secret_key_2026_dev

# AWS S3 Storage
# If credentials are not set, backend seamlessly stores files in local /server/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=escalatehq-proofs

# Nodemailer / Corporate Escalation Email
# Leave empty to use ethereal / mock email logger
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@escalatehq.org

# Frontend URL (for resolution links in emails)
CLIENT_URL=http://localhost:5173

# Google Maps API Key (Optional; client also includes simulated autocomplete fallback)
GOOGLE_MAPS_API_KEY=
